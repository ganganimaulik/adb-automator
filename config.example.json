{
  "llm": {
    "provider": "fireworks",
    "model": "accounts/fireworks/models/kimi-k2p6",
    "model_small": "accounts/fireworks/models/deepseek-v4-flash",
    "model_image": "",
    "model_skill": "",
    "temperature": 0.0,
    "max_tokens": 128000,
    "rpm": 120,
    "max_retries": 10,
    "service_tier": "",
    "api_key_env": "FIREWORKS_API_KEY",
    "vision_in_decider": false,
    "reasoning_effort": "",
    "reasoning_effort_hard": "high",
    "reasoning_style": "auto"
  },

  "device": {
    "serial": "",
    "max_depth": 40,
    "compressed": true,
    "settle_budget_s": 2.0,
    "watchdog_s": 60.0,
    "disable_animations": true,
    "disable_auto_rotate": true
  },

  "memory": {
    "db": "memory.db"
  },

  "safety": {
    "budget_usd": 2.0,
    "allow_destructive": false,
    "unattended": false
  },

  "run": {
    "max_steps": 250,
    "max_consecutive_failures": 4,
    "max_wall_clock_s": 1800,
    "artifacts_dir": "runs",
    "always_screenshot": false,
    "never_screenshot": false,
    "scratchpad_max_chars": 50000,
    "pager_sweep": true,
    "pager_sweep_max": 12
  },

  "skills": {
    "enabled": true,
    "skills_dir": "skills",
    "learn_after_run": true
  }
}
