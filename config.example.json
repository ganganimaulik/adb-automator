{
  "llm": {
    "provider": "fireworks",
    "model": "accounts/fireworks/models/kimi-k2p6",
    "model_small": "accounts/fireworks/models/deepseek-v4-flash",
    "model_image": "",
    "temperature": 0.0,
    "max_tokens": 128000,
    "rpm": 120,
    "max_retries": 10,
    "api_key_env": "FIREWORKS_API_KEY"
  },

  "device": {
    "serial": "",
    "max_depth": 40,
    "compressed": true,
    "settle_budget_s": 2.0,
    "watchdog_s": 60.0,
    "disable_animations": true
  },

  "memory": {
    "db": "memory.db",
    "enabled": true,
    "t_sim": 6,
    "t_strict": 3,
    "anchor_strict": 0.55,
    "anchor_relaxed": 0.35,
    "ambiguity_gap": 0.08
  },

  "safety": {
    "package_allowlist": [],
    "budget_usd": 2.0,
    "allow_destructive": false,
    "unattended": false
  },


  "run": {
    "max_steps": 60,
    "max_consecutive_failures": 4,
    "max_wall_clock_s": 1800,
    "artifacts_dir": "runs",
    "always_screenshot": false,
    "never_screenshot": false
  }
}
